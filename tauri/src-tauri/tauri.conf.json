{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Анализ работ",
  "version": "0.1.0",
  "identifier": "local.analiz.rabot.tauri",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Анализ выполненных работ",
        "width": 1320,
        "height": 900,
        "minWidth": 720,
        "minHeight": 530
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
