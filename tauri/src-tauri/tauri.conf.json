{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Анализ работ",
  "version": "1.12.11",
  "identifier": "local.analiz.rabot.tauri",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Анализ выполненных работ",
        "width": 1320,
        "height": 900,
        "minWidth": 720,
        "minHeight": 530,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "branding/analysis-reports.ico"
    ],
    "resources": {
      "branding/analysis-reports.ico": "analysis-reports.ico"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows-installer.nsh",
        "installerIcon": "branding/analysis-reports.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/v2029944-ui/HTML-test/releases/download/tauri-updates/tauri-latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
